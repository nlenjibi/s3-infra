        <!-- ══════════════ Benefits panel ══════════════ -->
        <mxCell id="benefits-panel" parent="1" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#147EBA;fillColor=#E6F2F8;align=left;verticalAlign=top;spacing=14;fontSize=15;fontStyle=1;fontColor=#232F3E;" value="Key Architecture Benefits&#xa;&#xa;&lt;font style=&quot;font-weight: normal; font-size: 14px;&quot;&gt;✓  Multi-AZ high availability — no single point of failure&#xa;✓  Auto-scaling application tier — handles traffic spikes automatically&#xa;✓  Zero-downtime deployments — new releases go live with no service interruption&#xa;✓  Automatic database failover — standby takes over within seconds&#xa;✓  Private network isolation — application and database are never internet-exposed&#xa;✓  Private connectivity to AWS services — no traffic ever leaves the AWS network&#xa;✓  Encryption at rest and in transit for all data&#xa;✓  Fully automated build, test, and deployment pipeline&lt;/font&gt;" vertex="1">
